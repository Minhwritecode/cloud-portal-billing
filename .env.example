APP_ENV=development
FLASK_ENV=development
OPENSTACK_MODE=mock
OPENSTACK_CLOUD=portal
# Set this to an absolute path on the machine running the portal.
# Example macOS: /Users/<user>/.config/openstack/clouds.yaml
# Example Linux: /home/<user>/.config/openstack/clouds.yaml
OS_CLIENT_CONFIG_FILE=
DATABASE_URL=sqlite:///cloudportal.db
BILLING_INTERVAL_SECONDS=60
